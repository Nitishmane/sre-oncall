# ── Secrets: never commit ──────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*_token*
secrets/

# ── Node / Next.js / Vercel ─────────────────────────────
node_modules/
.next/
.vercel/
dist/

# ── Python ──────────────────────────────────────────────
__pycache__/
.venv/
*.pyc

# ── Terraform (state + tfvars can embed secrets) ────────
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl
*.tfvars
!example.tfvars

# ── Local infra / runtime state ─────────────────────────
.data/
demo-env/.rendered/
kubeconfig*
mcp/.kube-config-container
*.kubeconfig
n8n-data/
*.sqlite
*.sqlite3
*.db
*.log

# ── Agent worktrees (git checkouts, never part of the tree) ──
.claude/worktrees/

# ── OS / editor ─────────────────────────────────────────
.DS_Store
Thumbs.db

# TypeScript incremental build state — machine-local, never useful in review.
*.tsbuildinfo

# skills.sh — third-party skills, pinned by skills-lock.json and restored with
# `npx skills experimental_install`. They were tracked briefly, and it cost two
# entire Qodo reviews: the vendored markdown dominated the PR diff, so a review
# of 3,000 lines of orchestrator and agent code reported only findings against
# Qodo's own skill files. Someone else's source does not belong in this diff.
.agents/
.claude/skills/
skills/qodo-*

# ── Local planning notes: not part of the submission ────
PLAN.md
research/
