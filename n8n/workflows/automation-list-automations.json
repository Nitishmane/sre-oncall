      "name": "Summarise",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "jsCode": "// One row per workflow: what it is called, whether it is live, and what\n// starts it. This is the answer to \"what can you run?\" from live state\n// rather than from a hardcoded list that drifts.\nconst body = $input.first().json;\nconst items = body.data ?? [];\nconst rows = items.map((w) => ({\n  name: w.name,\n  active: w.active === true,\n  id: w.id,\n  triggers: (w.nodes ?? []).filter((n) => /trigger/i.test(n.type)).map((n) => n.name),\n}));\nreturn [{ json: { count: rows.length, active: rows.filter((r) => r.active).length, workflows: rows } }];"
      }
    }
  ],
