# SRE-Oncall — local-host secrets template.
# Copy to .env and fill in:   cp .env.example .env
# .env is gitignored — NEVER commit it, never put real values in this file.
# Hackathon rule: no API keys or sensitive data in the repo or demo video.

# ── Model provider ──────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Alert ingress (Grafana → orchestrator webhook) ──────
GRAFANA_WEBHOOK_BEARER=          # required on POST /webhook/grafana; generate: openssl rand -hex 32

# ── Chatbox bridge (Vercel → ngrok → orchestrator) ──────
NGROK_AUTHTOKEN=
NGROK_DOMAIN=                    # claimed static domain, e.g. <name>.ngrok-free.app
TRUEFORGE_BRIDGE_TOKEN=          # bearer for the /chat proxy; generate: openssl rand -hex 32

# ── TrueForge harness + agent ───────────────────────────
TRUEFORGE_API_URL=http://127.0.0.1:8790   # harness (local mode); orchestrator talks to this
TRUEFORGE_TOKEN=                 # only if you enabled auth on the harness
TRUEFORGE_AGENT_NAME=sre-oncall
SRE_ONCALL_MODEL=anthropic/claude-opus-5

# ── Skills repo (git-backed runbooks) ───────────────────
SKILLS_REPO_URL=                 # https://github.com/<owner>/sre-oncall
SKILLS_REPO_REF=main

# ── Grafana MCP (local kube-prometheus-stack) ───────────
GRAFANA_URL=http://localhost:3000
GRAFANA_TOKEN=                   # Grafana service-account token

# ── GitHub MCP (fix PRs) ────────────────────────────────
GITHUB_TOKEN=

# ── Notion (postmortem database) ────────────────────────
NOTION_TOKEN=                    # internal integration token (ntn_...), database shared with it

# ── ArgoCD MCP (port-forwarded ArgoCD in kind) ──────────
ARGOCD_BASE_URL=https://localhost:8443
ARGOCD_API_TOKEN=

# ── n8n (workflow automation) ───────────────────────────
N8N_API_URL=http://localhost:5678
N8N_API_KEY=                     # n8n Settings → API → Create API Key
N8N_MCP_AUTH_TOKEN=              # bearer for the n8n-mcp builder (min 32 chars); container needs MCP_AUTH_TOKEN==AUTH_TOKEN
N8N_TOOLS_BEARER=                # bearer for the MCP Server Trigger standing tools

# ── Slack bot (Socket Mode) ─────────────────────────────
SLACK_BOT_TOKEN=                 # xoxb-...
SLACK_APP_TOKEN=                 # xapp-...

# ── Optional: Twilio (SMS/call beat in notify-oncall) ───
TWILIO_SID=
TWILIO_TOKEN=

# ── MCP bridge endpoints (see mcp/README.md; defaults shown) ──
# TrueForge accepts remote (URL) MCP servers only, so stdio servers run behind
# a local bridge. Override only if you moved a port.
MCP_GRAFANA_URL=http://127.0.0.1:8000/mcp
MCP_KUBERNETES_URL=http://127.0.0.1:8001/mcp
MCP_ARGOCD_URL=http://127.0.0.1:8002/mcp
MCP_TERRAFORM_URL=http://127.0.0.1:8003/mcp
MCP_NOTION_URL=http://127.0.0.1:8004/mcp
MCP_N8N_BUILDER_URL=http://127.0.0.1:3000/mcp
MCP_N8N_TOOLS_URL=http://127.0.0.1:5678/mcp/sre-oncall
KUBECONFIG_PATH=                 # defaults to ~/.kube/config; mounted read-only into the k8s bridge

# ── Orchestrator tuning (not secret) ────────────────────
PORT=8080
LOG_LEVEL=info
DATA_DIR=.data
MAX_CONCURRENT_SESSIONS=3        # global cap on concurrent harness sessions
ALERT_MAX_PER_HOUR=10            # hard bound on auto-triage during a storm
ALERT_COOLDOWN_SECONDS=3600      # per-incident: ignore repeats within this window
ALERT_FLAP_DELAY_SECONDS=60      # hold delay-pattern alerts; drop if they self-resolve
ALERT_DELAY_PATTERNS=            # regex of rule names to hold, e.g. ^(HighLatencyP99|TargetDown)$
ALERT_SKIP_PATTERNS=^Watchdog$   # regex of rule names never auto-triaged
POSTMORTEM_DELAY_SECONDS=60      # let the metric settle before drafting

# ────────────────────────────────────────────────────────
# Vercel chatbox project vars are set in the VERCEL DASHBOARD, never in a file:
#   AUTH_SECRET, AUTH_GITHUB_ID, AUTH_GITHUB_SECRET,
#   CHAT_ALLOWLIST, TRUEFORGE_API_URL, TRUEFORGE_BRIDGE_TOKEN
# ────────────────────────────────────────────────────────
