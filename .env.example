# SRE-Oncall — local-host secrets template.
# Copy to .env and fill in:   cp .env.example .env
# .env is gitignored — NEVER commit it, never put real values in this file.
# Hackathon rule: no API keys or sensitive data in the repo or demo video.
#
# Keep every comment on its own line. This file is read by both Node
# (--env-file) and Docker Compose (--env-file), and they disagree about
# trailing `# comments` — Compose has handed a comment to a container as a
# value more than once.

# ── Model provider ──────────────────────────────────────
# Switching vendors is these two values and nothing else: SRE_ONCALL_MODEL
# (below) names `provider/model`, and the provider half decides which key is
# read. See what this harness offers:
#   npm run provision -- --list-models
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Alert ingress (Grafana → orchestrator webhook) ──────
# required on POST /webhook/grafana; generate: openssl rand -hex 32
GRAFANA_WEBHOOK_BEARER=

# ── Chatbox bridge (Vercel → ngrok → orchestrator) ──────
NGROK_AUTHTOKEN=
# claimed static domain, e.g. <name>.ngrok-free.app
NGROK_DOMAIN=
# bearer for the /chat proxy; generate: openssl rand -hex 32
TRUEFORGE_BRIDGE_TOKEN=

# ── TrueForge harness + agent ───────────────────────────
# harness (local mode); orchestrator talks to this
TRUEFORGE_API_URL=http://localhost:8790
# only if you enabled auth on the harness
TRUEFORGE_TOKEN=
TRUEFORGE_AGENT_NAME=sre-oncall
# provider/model. e.g. openai/gpt-5-6-sol, anthropic/claude-opus-5
SRE_ONCALL_MODEL=openai/gpt-5-6-sol
# optional cheaper model for summaries; defaults to SRE_ONCALL_MODEL
SRE_ONCALL_SUMMARY_MODEL=

# ── Skills repo (git-backed runbooks) ───────────────────
# https://github.com/<owner>/sre-oncall
SKILLS_REPO_URL=
SKILLS_REPO_REF=main

# ── Grafana MCP (local kube-prometheus-stack) ───────────
GRAFANA_URL=http://localhost:3000
# Grafana service-account token
GRAFANA_TOKEN=

# ── GitHub MCP (fix PRs) ────────────────────────────────
GITHUB_TOKEN=

# ── Notion (postmortem database) ────────────────────────
# internal integration token (ntn_...), database shared with it
NOTION_TOKEN=

# ── ArgoCD MCP (port-forwarded ArgoCD in kind) ──────────
ARGOCD_BASE_URL=https://localhost:8443
ARGOCD_API_TOKEN=

# ── n8n (workflow automation) ───────────────────────────
N8N_API_URL=http://localhost:5678
# n8n Settings → API → Create API Key
N8N_API_KEY=
# bearer for the n8n-mcp builder (min 32 chars); container needs MCP_AUTH_TOKEN==AUTH_TOKEN
N8N_MCP_AUTH_TOKEN=
# bearer for the MCP Server Trigger standing tools
N8N_TOOLS_BEARER=

# ── Slack bot (Socket Mode) — see docs/slack-setup.md ───
# Both tokens must be set for the bot to start; without them the alert
# pipeline still runs, just without a Slack surface.
# xoxb-...
SLACK_BOT_TOKEN=
# xapp-... (app-level token, connections:write)
SLACK_APP_TOKEN=
# channel ID where alert sessions announce, e.g. C0XXXXXXXXX
SLACK_INCIDENT_CHANNEL=
# comma-separated user IDs allowed to approve; empty = anyone in the workspace
SLACK_APPROVER_IDS=

# ── Optional: Twilio (SMS/call beat in notify-oncall) ───
TWILIO_SID=
TWILIO_TOKEN=

# ── MCP bridge endpoints (see mcp/README.md; defaults shown) ──
# TrueForge accepts remote (URL) MCP servers only, so stdio servers run behind
# a local bridge. Override only if you moved a port.
MCP_GRAFANA_URL=http://127.0.0.1:8100/mcp
MCP_KUBERNETES_URL=http://127.0.0.1:8101/mcp
MCP_ARGOCD_URL=http://127.0.0.1:8102/mcp
MCP_TERRAFORM_URL=http://127.0.0.1:8103/mcp
MCP_NOTION_URL=http://127.0.0.1:8104/mcp
MCP_N8N_BUILDER_URL=http://127.0.0.1:8105/mcp
MCP_N8N_TOOLS_URL=http://127.0.0.1:5678/mcp/sre-oncall
# defaults to ~/.kube/config; mounted read-only into the k8s bridge
KUBECONFIG_PATH=

# ── Orchestrator tuning (not secret) ────────────────────
PORT=8080
LOG_LEVEL=info
DATA_DIR=.data
# global cap on concurrent harness sessions
MAX_CONCURRENT_SESSIONS=3
# hard bound on auto-triage during a storm
ALERT_MAX_PER_HOUR=10
# per-incident: ignore repeats within this window
ALERT_COOLDOWN_SECONDS=3600
# hold delay-pattern alerts; drop if they self-resolve
ALERT_FLAP_DELAY_SECONDS=60
# regex of rule names to hold, e.g. ^(HighLatencyP99|TargetDown)$
ALERT_DELAY_PATTERNS=
# regex of rule names never auto-triaged
ALERT_SKIP_PATTERNS=^Watchdog$
# let the metric settle before drafting
POSTMORTEM_DELAY_SECONDS=60
# hours between automatic handoff sessions, e.g. 12 for a twice-daily shift
# change; leave unset to disable the schedule (POST /handoff still works)
HANDOFF_INTERVAL_HOURS=

# ────────────────────────────────────────────────────────
# The console (web/) reads its own vars. In production they are set in the
# VERCEL DASHBOARD, never in a file. For local development, export them in the
# shell that runs `npm run dev:web` — see web/README.md.
#
#   AUTH_SECRET             openssl rand -hex 32
#   AUTH_GITHUB_ID          GitHub OAuth app
#   AUTH_GITHUB_SECRET
#   CHAT_ALLOWLIST          comma-separated GitHub logins; EMPTY MEANS NOBODY
#   TRUEFORGE_API_URL       https://<name>.ngrok-free.app/chat  (the tunnel)
#   TRUEFORGE_BRIDGE_TOKEN  must equal the value above
#
# Vercel holds only those. No vendor credentials ever leave this host.
# ────────────────────────────────────────────────────────
